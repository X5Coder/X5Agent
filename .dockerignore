# Live user data — NEVER baked into the image (lives in named volumes).
X5Agent/
# Model weights — downloaded once at runtime into the x5-models volume.
**/*.safetensors
**/*.bin
**/*.onnx
**/*.pt
**/*.ct2
**/*.engine
# Secrets — never in the image.
.env
.env.local
# Central license server — separate deployment, never inside the client image.
license-server/
# Build junk.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.opencode/
seed_build.err
seed_build.log
.DS_Store
# NOTE: .git is intentionally KEPT — the entrypoint refreshes source
# from GitHub with `git pull --ff-only` on every container start.
