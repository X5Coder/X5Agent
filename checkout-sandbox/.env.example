# URL of the license server this sandbox completes payments against.
LICENSE_API_URL=http://127.0.0.1:8788

# REQUIRED. Must equal SANDBOX_SHARED_SECRET on the license server.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SANDBOX_SHARED_SECRET=

# Listen port (the license server's SANDBOX_PUBLIC_URL must point here).
PORT=8789
