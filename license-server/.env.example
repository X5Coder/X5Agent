# Environment: development | test | production
ENVIRONMENT=development

# SQLite for local development. Production must use Postgres:
# DATABASE_URL=postgresql+psycopg://x5license:CHANGE_ME@127.0.0.1:5432/x5license
DATABASE_URL=sqlite:///./license.db

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

ENTITLEMENT_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=90

# Where the Ed25519 signing keypair lives (gitignored).
KEYS_DIR=./keys

# Optional first-run admin bootstrap (created only when the table is empty).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Brute-force bound for signup/login (per process, per client address).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=5

# Sandbox checkout (fake payment provider) until Dodo is connected.
# CHECKOUT_PROVIDER=sandbox
# SANDBOX_PUBLIC_URL=http://YOUR_HOST:8789
# SANDBOX_SHARED_SECRET=generate-with-the-command-above
# CHECKOUT_TTL_SECONDS=1800
# CHECKOUT_RETURN_URL=http://localhost:7777/subscription
